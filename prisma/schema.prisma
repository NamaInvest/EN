  uploadedAt      DateTime?      @map("uploaded_at")
  status          String         @default("PENDING") // PENDING, GENERATED, UPLOADED, ACCEPTED, REJECTED
  rejectionReason String?        @map("rejection_reason")
  items           WPSBatchItem[]

