  statementNumber String?     @map("statement_number")
  statementDate   DateTime    @map("statement_date")
  openingBalance  Decimal     @map("opening_balance") @db.Decimal(18, 4)
  closingBalance  Decimal     @map("closing_balance") @db.Decimal(18, 4)
  currency        String      @default("SAR")
  fileFormat      String?     @map("file_format") // MT940, CAMT_053, OFX, CSV
  fileName        String?     @map("file_name")
  fileContent     String?     @map("file_content") @db.Text
  status          String      @default("IMPORTED") // IMPORTED, RECONCILED
  importedBy      Int?        @map("imported_by")
  reconciledAt    DateTime?   @map("reconciled_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  lines BankStatementLine[]

  @@map("bank_statements")
}

model BankStatementLine {
  id                     Int           @id @default(autoincrement())
  statementId            Int           @map("statement_id")
  statement              BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  lineNumber             Int?          @map("line_number")
  transactionDate        DateTime      @map("transaction_date") // Equivalent to valueDate
  bookingDate            DateTime?     @map("booking_date")
  description            String        @db.Text
  reference              String?
  counterpartyName       String?       @map("counterparty_name")
  counterpartyIBAN       String?       @map("counterparty_iban")
  amount                 Decimal       @db.Decimal(18, 4) // Legacy, but we add debit/credit
  debit                  Decimal       @default(0) @db.Decimal(18, 4)
  credit                 Decimal       @default(0) @db.Decimal(18, 4)
  balance                Decimal?      @db.Decimal(18, 4)
  type                   String // DEBIT, CREDIT
  reconciledStatus       String        @default("UNRECONCILED") // UNRECONCILED, MATCHED, POSTED
  matchedDocId           Int?          @map("matched_doc_id") // Equivalent to matchedTransactionId
  matchedTransactionType String?       @map("matched_transaction_type") // JE, PAYMENT, RECEIPT
  matchConfidence        Decimal?      @db.Decimal(5, 2) // 0-100%
  matchedBy              Int?          @map("matched_by")
  matchedAt              DateTime?     @map("matched_at")

  BankReconMatch BankReconMatch[]

  @@map("bank_statement_lines")
}

model BankReconRule {
  id                Int       @id @default(autoincrement())
  bankAccountId     Int?
  name              String
  priority          Int
  // Match conditions (JSON)
