// ==================== Field-Level Audit Trail (Foundation 0.3) ====================
// ظٹظ„طھظ‚ط· ظƒظ„ طھط¹ط¯ظٹظ„ ط¹ظ„ظ‰ ط§ظ„ط­ظ‚ظˆظ„ ط§ظ„ط­ط³ط§ط³ط© ظ‚ط¨ظ„/ط¨ط¹ط¯ + ظ…ظ† + ظ…ظ† ط£ظٹظ†
model FieldAuditLog {
  id            Int      @id @default(autoincrement())
  entityType    String   @map("entity_type") // ط§ط³ظ… ط§ظ„ظ…ظˆط¯ظٹظ„ (JournalEntry, Account, ...)
  entityId      Int      @map("entity_id") // PK ط§ظ„ط®ط§طµ ط¨ط§ظ„ط³ط¬ظ„ ط§ظ„ظ…ظڈط¹ط¯ظژظ‘ظ„
  fieldName     String   @map("field_name") // ط§ط³ظ… ط§ظ„ط­ظ‚ظ„ ط§ظ„ظ…ظڈط¹ط¯ظژظ‘ظ„
  oldValue      String?  @map("old_value") // JSON-stringified
  newValue      String?  @map("new_value") // JSON-stringified
  changeType    String   @map("change_type") // create | update | delete
  userId        Int?     @map("user_id")
  userEmail     String?  @map("user_email")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  transactionId String?  @map("transaction_id") // ظ„ط±ط¨ط· طھط¹ط¯ظٹظ„ط§طھ ظ†ظپط³ ط§ظ„ط¹ظ…ظ„ظٹط©
  changedAt     DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId])
  @@index([userId, changedAt])
  @@index([changedAt])
  @@map("field_audit_logs")
}

// ==================== Numbering Sequences Engine (Foundation 0.1) ====================
// ظ…ط­ط±ظ‘ظƒ طھط±ظ‚ظٹظ… ظ…ظˆط­ظ‘ط¯ ظ„ظƒظ„ ط£ظ†ظˆط§ط¹ ط§ظ„ظˆط«ط§ط¦ظ‚
// Atomic increment via Prisma $transaction with row-level lock
model NumberingSequence {
  id             Int       @id @default(autoincrement())
  code           String    @map("code") // JE, INV, PO, GRN, PR, RFQ, SO, DN, FA, EMP, SAL, WO, ...
  name           String? // ظˆطµظپ ط§ط®طھظٹط§ط±ظٹ ظ„ظ„ط¹ط±ط¶ ظپظٹ ط§ظ„ط¥ط¹ط¯ط§ط¯ط§طھ
  prefix         String    @default("")
  suffix         String    @default("")
  padLength      Int       @default(6) @map("pad_length") // 6 â†’ 000001
  current        BigInt    @default(0) // ط¢ط®ط± ط±ظ‚ظ… ظ…ظڈظˆظ„ظژظ‘ط¯
  resetFrequency String    @default("never") @map("reset_frequency") // never | yearly | monthly
  branchId       Int?      @map("branch_id")
  fiscalYear     Int?      @map("fiscal_year") // ط§ظ„ط³ظ†ط© ط§ظ„ظ…ط±ط¬ط¹ظٹط© ظ„ظ„ظ€ reset
  fiscalMonth    Int?      @map("fiscal_month") // ط§ظ„ط´ظ‡ط± ط§ظ„ظ…ط±ط¬ط¹ظٹ (ظ„ظ€ monthly)
  lastReset      DateTime? @map("last_reset")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // ط§ظ„ظ…ظپطھط§ط­ ط§ظ„ظپط±ظٹط¯: ظƒظ„ (code, branchId, fiscalYear, fiscalMonth) ط³ظ„ط³ظ„ط© ظ…ط³طھظ‚ظ„ط©
  // branchId=null â†’ ط³ظ„ط³ظ„ط© ط¹ط§ظ„ظ…ظٹط© ظ„ظ„ط´ط±ظƒط©
  @@unique([code, branchId, fiscalYear, fiscalMonth], name: "uq_numbering_seq")
  @@index([code, isActive])
  @@map("numbering_sequences")
}
