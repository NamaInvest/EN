// ==================== 18. AuditLog ====================
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  tableName String?  @map("table_name")
  recordId  Int?     @map("record_id")
  details   String?
  date      DateTime @default(now())

