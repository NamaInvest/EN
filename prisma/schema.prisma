// ==================== 30. JournalEntries ====================
model JournalEntry {
  id           Int      @id @default(autoincrement())
  entryNumber  String   @map("entry_number")
  entryDate    String   @map("entry_date")
  description  String?
  reference    String?
  totalDebit   Float    @default(0) @map("total_debit")
  totalCredit  Float    @default(0) @map("total_credit")
  status       String   @default("posted")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  currencyId   Int?     @map("currency_id")
  exchangeRate Float    @default(1.0) @map("exchange_rate")

  lines    JournalLine[]
  branch   Branch?       @relation(fields: [branchId], references: [id])
  branchId Int?          @map("branch_id")

  @@index([entryDate])
  @@index([status])
  @@map("journal_entries")
}

// ==================== 31. JournalLines ====================
model JournalLine {
  id               Int     @id @default(autoincrement())
  entryId          Int     @map("entry_id")
  accountId        Int     @map("account_id")
  costCenterId     Int?    @map("cost_center_id")
  description      String?
  debit            Float   @default(0)
  credit           Float   @default(0)
  foreignDebit     Float   @default(0) @map("foreign_debit")
  foreignCredit    Float   @default(0) @map("foreign_credit")
  isReconciled     Boolean @default(false) @map("is_reconciled")
  reconciliationId Int?    @map("reconciliation_id")

  entry      JournalEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    Account             @relation(fields: [accountId], references: [id])
  costCenter CostCenter?         @relation(fields: [costCenterId], references: [id])
  bankRecon  BankReconciliation? @relation(fields: [reconciliationId], references: [id])

  @@map("journal_lines")
}

// ==================== 32. Quotations ====================
