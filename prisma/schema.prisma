  difference       Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("petty_cash_transactions")
}

// ==================== 60. Sales & Distribution (Phase 4) ====================
model Route {
