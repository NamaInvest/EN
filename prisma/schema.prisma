model Lead {
  id              Int      @id @default(autoincrement())
  companyName     String   @map("company_name")
  contactPerson   String   @map("contact_person")
  email           String?
  phone           String?
  source          String? // e.g., 'Website', 'Cold Call', 'Referral'
