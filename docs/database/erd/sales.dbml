  emailLastBounceReason String
  statementDispatchLogs StatementDispatchLog [not null]
  statementAccessLogs StatementAccessLog [not null]
  dunningCurrentLevel Int [not null, default: 0]
  dunningLastRunAt DateTime
  dunningSnoozeUntil DateTime
  dunningSnoozeReason String
  dunningSnoozedByUserId String
  dunningPaused Boolean [not null, default: false]
  dunningPauseReason String
