  creditHoldReason String
  creditHoldDate DateTime
  creditHoldByUserId String
  creditHoldExpiresAt DateTime
  legalActionInProgress Boolean [not null, default: false]
  legalCaseId Int
  inCollectionAgency Boolean [not null, default: false]
  dunningPreferredChannel String [not null, default: 'EMAIL']
  dunningOptOutChannels String[] [not null]
  promisesToPay PromiseToPay [not null]
  campaigns DunningCampaign [not null]
  letters DunningLetter [not null]
  collectionAssignments CollectionAssignment [not null]
  creditActions CustomerCreditAction [not null]
  SupplierBankAccount SupplierBankAccount [not null]
  SalesContract SalesContract [not null]
