Table customers {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  customerNo String [unique]
  name String [not null]
  phone String
  email String
  address String
  street String
  buildingNumber String
  district String
  city String
  postalCode String
  type Int [not null, default: 0]
  balance Decimal [not null, default: 0]
  creditLimit Decimal [not null, default: 0]
  taxNumber String
  crNo String
  notes String
  active Boolean [not null, default: true]
  status String [not null, default: 'ACTIVE']
  password String
  b2bEnabled Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  salesInvoices sales_invoices [not null]
  purchaseInvoices purchase_invoices [not null]
  purchaseOrders purchase_orders [not null]
  installments installments [not null]
  loyaltyPoints loyalty_points [not null]
  bookings bookings [not null]
