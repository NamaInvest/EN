  purchaseReturns purchase_returns [not null]
  supplierContracts supplier_contracts [not null]
  whtTransactions wht_transactions [not null]
  RentInvoice rent_invoices [not null]
  ECLAssessment ecl_assessments [not null]
  PaymentRunLine payment_run_lines [not null]
  SubcontractingPO subcontracting_pos [not null]
  savedPaymentMethods saved_payment_methods [not null]
  dunningRuns dunning_runs [not null]
  subscriptions customer_subscriptions [not null]
  emailStatementsEnabled Boolean [not null, default: false]
  statementFrequency String [not null, default: 'NEVER']
  statementChannel String [not null, default: 'EMAIL']
  statementEmail String
  statementWhatsapp String
  statementCcEmails String
  statementBccEmails String
  statementLanguage String [not null, default: 'ar']
  statementTemplateId Int
  statementTemplate StatementTemplate
  statementDayOfMonth Int [not null, default: 1]
  statementSendTime String [not null, default: '06:00']
  statementIncludeAging Boolean [not null, default: true]
