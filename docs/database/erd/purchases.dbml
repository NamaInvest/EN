  purchaseInvoices purchase_invoices [not null]
}

Table accounts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  code String [not null]
  name String [not null]
  nameEn String [not null, default: '']
  type String [not null]
  parentId Int [not null, default: 0]
  level Int [not null, default: 1]
  isActive Boolean [not null, default: true]
  balance Decimal [not null, default: 0]
  zakatCategory String
  journalLines journal_lines [not null]
  LandedCost landed_costs [not null]
  bankChecks check_transactions [not null]
  bankRecons bank_reconciliations [not null]
  BudgetLine fng_budget_lines [not null]
  Encumbrance fng_encumbrances [not null]
  sourceMappings account_mappings [not null]
  targetMappings account_mappings [not null]
  OpeningBalance OpeningBalance [not null]
  deletedAt DateTime [note: '[SD]']
  deletedBy String
}

Table goods_receipt_notes {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  grnNo Int [not null]
  date DateTime [default: `now()`, not null]
  supplierId Int
  orderId Int
  stockId Int [not null, default: 1]
  status String [not null, default: 'received']
  receivedBy Int
  notes String
  supplier customers
  order purchase_orders
  stock stocks
  receiver users
  details goods_receipt_note_details [not null]
  asnId String
  expectedArrivalDate DateTime
  rejectionQty Decimal
}

Table wht_transactions {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  supplierId Int [not null]
  invoiceId Int [not null]
  baseAmount Decimal [not null]
  whtRate Decimal [not null]
  whtAmount Decimal [not null]
  certificateNumber String
  paidToZATCA Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  supplier customers [not null]
  invoice purchase_invoices [not null]
  serviceCategory String
  treatyApplied Boolean [not null, default: false]
  treatyCountry String
  form14BatchId Int
  form14Batch wht_form14_batches
}

Table subcontracting_pos {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  supplierId Int [not null]
  productToReceive Int [not null]
  productsToSend String [not null]
  expectedDate DateTime [not null]
  status String [not null, default: 'DRAFT']
  createdAt DateTime [default: `now()`, not null]
  supplier customers [not null]
  product products [not null]
  movements subcontract_movements [not null]
}

