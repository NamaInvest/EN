  ticket ice_support_tickets [not null]
  admin ice_admins
}

Table ice_system_settings {
  id Int [pk, increment]
  key String [unique, not null]
  value String [not null]
  description String
  updatedAt DateTime [not null]
}

Table idempotency_records {
  id Int [pk, increment]
  tenantId String [not null]
  key String [not null]
  endpoint String [not null]
  requestHash String [not null]
  status IdempotencyStatus [not null, default: 'IN_PROGRESS']
  responseCode Int
  responseBody Json
  lockedAt DateTime [default: `now()`, not null]
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (tenantId, endpoint, key) [unique]
  }
}

Table outbox_events {
  id Int [pk, increment]
  tenantId String [not null]
  idempotencyKey String
  aggregateId String [not null]
  aggregateType String [not null]
  eventType String [not null]
  payload Json [not null]
  status String [not null, default: 'PENDING']
  error String
  createdAt DateTime [default: `now()`, not null]
  processedAt DateTime
  attempts Int [not null, default: 0]

  indexes {
    (tenantId, idempotencyKey) [unique]
  }
}

Enum FinancialPeriodStatus {
  OPEN
  SOFT_LOCKED
  HARD_LOCKED
}

Enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  CANCEL
  VOID
  PRINT
  EXPORT
  LOGIN
  LOGOUT
}

Enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

