Ref: treasury.userId > users.id

Ref: treasury.branchId > branches.id

Ref: journal_lines.reconciliationId > bank_reconciliations.id

Ref: bank_transactions.bankAccountId > bank_accounts.id

Ref: bank_reconciliations.bankAccountId > accounts.id

Ref: petty_cash_transactions.employeeId > employees.id

Ref: fng_petty_cash_funds.custodianId > employees.id

Ref: payment_term_installments.termId > payment_terms.id [delete: Cascade]

Ref: bank_statements.bankAccountId > bank_accounts.id

Ref: bank_statement_lines.statementId > bank_statements.id [delete: Cascade]

Ref: bank_statement_lines.reconciliationId > BankReconPeriod.id

Ref: bank_recon_rules.bankAccountId > bank_accounts.id

Ref: BankReconPeriod.bankAccountId > bank_accounts.id

Ref: bank_recon_matches.bankLineId > bank_statement_lines.id [delete: Cascade]

Ref: FixedAsset.cguId > CashGeneratingUnit.id

Ref: cash_applications.batchId > cash_application_batches.id

Ref: payment_run_lines.runId > payment_runs.id [delete: Cascade]

Ref: payment_run_lines.supplierId > customers.id

Ref: PaymentRunBankFile.runId > payment_runs.id [delete: Cascade]

Ref: PaymentRunApproval.runId > payment_runs.id [delete: Cascade]

Ref: payment_transactions.gatewayId > payment_gateways.id

Ref: payment_transactions.invoiceId > sales_invoices.id

Ref: saved_payment_methods.customerId > customers.id

Ref: saved_payment_methods.gatewayId > payment_gateways.id

Ref: customer_subscriptions.paymentMethodId > saved_payment_methods.id

Ref: open_item_matchings.treasuryId > treasury.id [delete: Restrict]

Enum FinancialPeriodStatus {
  OPEN
  SOFT_LOCKED
  HARD_LOCKED
}

Enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  CANCEL
  VOID
  PRINT
  EXPORT
  LOGIN
  LOGOUT
}

Enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}