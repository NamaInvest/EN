Ref: sales_invoices.costCenterId > cost_centers.id

Ref: expenses.costCenterId > cost_centers.id

Ref: journal_entries.branchId > branches.id

Ref: journal_entries.bookId > accounting_books.id

Ref: journal_lines.entryId > journal_entries.id [delete: Cascade]

Ref: journal_lines.accountId > accounts.id

