Ref: OpeningBalance.accountId > accounts.id

Ref: rent_invoices.customerId > customers.id

Ref: rent_invoice_details.invoiceId > rent_invoices.id [delete: Cascade]

Ref: journal_template_lines.templateId > journal_templates.id [delete: Cascade]

Ref: bank_statements.bankAccountId > bank_accounts.id

Ref: IntraDayBalance.bankAccountId > bank_accounts.id

Ref: bank_recon_rules.bankAccountId > bank_accounts.id

Ref: BankReconPeriod.bankAccountId > bank_accounts.id

Ref: IfrsLeaseContract.lessorVendorId > customers.id

Ref: IfrsLeaseScheduleLine.scheduleId > IfrsLeaseSchedule.id [delete: Cascade]

Ref: IfrsLeaseModification.contractId > IfrsLeaseContract.id

Ref: IfrsLeaseTermination.contractId > IfrsLeaseContract.id

Ref: IfrsSublease.mainLeaseId > IfrsLeaseContract.id

Ref: IfrsLeaseImpairment.contractId > IfrsLeaseContract.id

Ref: IfrsVariableLeasePayment.contractId > IfrsLeaseContract.id

Ref: wht_transactions.supplierId > customers.id

Ref: wht_transactions.invoiceId > purchase_invoices.id

Ref: wht_transactions.form14BatchId > wht_form14_batches.id

Ref: account_mappings.bookId > accounting_books.id [delete: Cascade]

Ref: account_mappings.sourceAccountId > accounts.id

Ref: account_mappings.targetAccountId > accounts.id

Ref: BookComparison.bookAId > accounting_books.id

Ref: BookComparison.bookBId > accounting_books.id

Ref: crm_contacts.accountId > crm_accounts.id [delete: Cascade]

Ref: crm_opportunities.accountId > crm_accounts.id

Enum FinancialPeriodStatus {
  OPEN
  SOFT_LOCKED
  HARD_LOCKED
}

Enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  CANCEL
  VOID
  PRINT
  EXPORT
  LOGIN
  LOGOUT
}

Enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}