Ref: JournalEntry.bookId > AccountingBook.id
Ref: JournalEntry.replicatedFromId > JournalEntry.id
Ref: JournalLine.entryId > JournalEntry.id
Ref: JournalLine.accountId > Account.id
Ref: FiscalPeriod.year > FiscalYear.yearNumber
Ref: JournalTemplateLine.templateId > JournalTemplate.id
Ref: PaymentTermInstallment.termId > PaymentTerm.id
Ref: RevenueRecognitionLine.scheduleId > DeferredRevenueSchedule.id
Ref: PaymentRunLine.runId > PaymentRun.id
Ref: PaymentRunApproval.runId > PaymentRun.id
Ref: AccountingBook.sourceBookId > AccountingBook.id
Ref: AccountMapping.bookId > AccountingBook.id
Ref: AccountMapping.sourceAccountId > Account.id
Ref: AccountMapping.targetAccountId > Account.id
Ref: PaymentTransaction.gatewayId > PaymentGateway.id
Ref: ExpenseLine.reportId > ExpenseReport.id
