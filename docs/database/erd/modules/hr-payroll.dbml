Table Employee {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  employeeNo String [unique]
  name String [not null]
  phone String
  position String
  salary Decimal [not null, note: 'Sensitive Financial Field']
  housingAllowance Decimal [not null]
  transportAllowance Decimal [not null]
  otherAllowance Decimal [not null]
  bankName String
  iban String
  startDate String [note: 'Sensitive Financial Field']
  active Boolean [not null]
  createdAt DateTime [not null]
  branchId Int
  nationality String [not null]
  iqamaNumber String
  passportNumber String
  idNumber String
  birthDate DateTime
  gender String
  maritalStatus String [note: 'Sensitive Financial Field']
  faceDescriptor String
  department String [note: 'Sensitive Financial Field']
  managerId Int
  qiwaWageProtectionId String
  mudadStatus String
  deletedAt DateTime
  deletedBy String
  Note: '''Note: 'TENANT SCOPED''''
}

