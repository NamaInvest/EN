Ref: Employee.managerId > Employee.id
Ref: Attendance.employeeId > Employee.id
Ref: Salary.employeeId > Employee.id
Ref: EmployeeLoan.employeeId > Employee.id
Ref: JobApplicant.jobPostingId > JobPosting.id
Ref: EmployeeEvaluation.employeeId > Employee.id
Ref: EmployeeEvaluation.evaluatorId > Employee.id
Ref: PayrollInvoice.employeeId > Employee.id
Ref: PayrollInvoiceDetail.invoiceId > PayrollInvoice.id
Ref: WPSBatch.payrollRunId > PayrollRun.id
Ref: WPSBatchItem.batchId > WPSBatch.id
Ref: WPSBatchItem.employeeId > Employee.id
Ref: GOSIContribution.payrollRunId > PayrollRun.id
Ref: LeaveBalance.employeeId > Employee.id
Ref: LeaveAccrual.employeeId > Employee.id
Ref: LeaveRequest.employeeId > Employee.id
