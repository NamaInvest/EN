Ref: UserBackupCode.userId > User.id
Ref: UserPermission.userId > User.id
Ref: SubscriptionPayment.subscriptionId > Subscription.id
Ref: TenantFeatureFlag.tenantAccountId > TenantAccount.id
Ref: PosSession.userId > User.id
Ref: PosSessionMovement.sessionId > PosSession.id
Ref: CustomerSubscription.planId > SubscriptionPlan.id
Ref: SubscriptionInvoice.subscriptionId > CustomerSubscription.id
Ref: IceTenantSubscription.planId > IceSubscriptionPlan.id
Ref: IceSubscriptionInvoice.subscriptionId > IceTenantSubscription.id
