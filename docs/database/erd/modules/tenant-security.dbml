Table User {
  id Int [primary key, not null]
  username String [unique, not null]
  passwordHash String [not null]
  fullName String [not null]
  role String [not null]
  phone String
  active Boolean [not null]
  sessionToken String
  deviceToken String
  deviceName String
  deviceBoundAt DateTime
  createdAt DateTime [not null]
  branchId Int
  defaultPage String
  totpSecretEncrypted String
  totpIv String
  totpAuthTag String
  mfaEnabled Boolean [not null]
  mfaMethod String
  mfaPendingActivation Boolean [not null, note: 'Sensitive Financial Field']
  mfaEnrolledAt DateTime
  mfaLastUsedAt DateTime
  mfaFailedAttempts Int [not null]
  mfaLockedUntil DateTime
  mfaRequiredByPolicy Boolean [not null, note: 'Sensitive Financial Field']
  mfaPolicyId Int [note: 'Sensitive Financial Field']
  mfaGracePeriodEndsAt DateTime
  mfaPhoneVerified String [note: 'Sensitive Financial Field']
  mfaPhoneVerifiedAt DateTime [note: 'Sensitive Financial Field']
  deletedAt DateTime
}

