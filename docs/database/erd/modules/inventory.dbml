Ref: ProductUnit.unitId > Unit.id
Ref: ProductUnit.parentUnitId > ProductUnit.id
Ref: ProductStock.stockId > Stock.id
Ref: ProductStock.binId > WarehouseBin.id
Ref: StockMovement.stockId > Stock.id
Ref: StockMovement.batchId > ProductBatch.id
Ref: StockTransferDetail.transferId > StockTransfer.id
Ref: StocktakeItem.stocktakeId > Stocktake.id
Ref: WarehouseZone.stockId > Stock.id
Ref: OpenItem.parentOpenItemId > OpenItem.id
Ref: ItemApplication.paymentOpenItemId > OpenItem.id
Ref: ItemApplication.invoiceOpenItemId > OpenItem.id
