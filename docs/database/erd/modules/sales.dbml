Table Customer {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  customerNo String [unique]
  name String [not null]
  phone String
  email String
  address String
  street String
  buildingNumber String
  district String
  city String
  postalCode String
  type Int [not null]
  balance Decimal [not null]
  creditLimit Decimal [not null]
  taxNumber String
  crNo String
  notes String
  active Boolean [not null]
  status String [not null]
  password String
  b2bEnabled Boolean [not null]
  createdAt DateTime [not null]
  routeId Int
  emailStatementsEnabled Boolean [not null]
  statementFrequency String [not null]
  statementChannel String [not null]
  statementEmail String
  statementWhatsapp String [note: 'Sensitive Financial Field']
  statementCcEmails String
  statementBccEmails String
  statementLanguage String [not null]
  statementTemplateId Int
  statementDayOfMonth Int [not null]
  statementSendTime String [not null]
  statementIncludeAging Boolean [not null]
  statementIncludeClosed Boolean [not null]
  statementIncludeOpenOnly Boolean [not null]
  statementWatermark String [note: 'Sensitive Financial Field']
  statementSinceLastSent Boolean [not null]
  emailDeliveryIssue String
  emailDeliveryIssueDate DateTime
  emailLastBounceReason String
  dunningCurrentLevel Int [not null]
  dunningLastRunAt DateTime
  dunningSnoozeUntil DateTime
  dunningSnoozeReason String
  dunningSnoozedByUserId String
  dunningPaused Boolean [not null]
  dunningPauseReason String
  creditHold Boolean [not null]
  creditHoldReason String
  creditHoldDate DateTime
  creditHoldByUserId String
  creditHoldExpiresAt DateTime
  legalActionInProgress Boolean [not null]
  legalCaseId Int
  inCollectionAgency Boolean [not null]
  dunningPreferredChannel String [not null]
  dunningOptOutChannels String [not null]
  isForeignVendor Boolean [not null]
  whtCountryCode String
  whtTaxResidencyCert String
  whtTaxResidencyExpiry DateTime
  defaultWhtRuleId Int
  deletedAt DateTime
  deletedBy String
  Note: '''Note: 'TENANT SCOPED''''
}

