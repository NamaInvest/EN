Ref: FixedAsset.categoryId > FixedAssetCategory.id
Ref: FixedAsset.parentAssetId > FixedAsset.id
Ref: FixedAssetCategory.parentCategoryId > FixedAssetCategory.id
Ref: AssetDepreciationLog.assetId > FixedAsset.id
Ref: AssetImpairmentRecord.assetId > FixedAsset.id
Ref: AssetTransferRecord.assetId > FixedAsset.id
Ref: AssetMaintenanceRecord.assetId > FixedAsset.id
Ref: AssetInsuranceClaim.assetId > FixedAsset.id
Ref: AssetUsageLog.assetId > FixedAsset.id
Ref: AssetReclassification.assetId > FixedAsset.id
Ref: AssetDocument.assetId > FixedAsset.id
Ref: AssetImpairment.assetId > Asset.id
Ref: AssetRevaluation.assetId > Asset.id
