Table Maintenance {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  date DateTime [not null]
  customerName String
  phone String
  deviceType String
  problem String
  cost Decimal [not null]
  status String [not null]
  userId Int
  notes String
  Note: '''Note: 'TENANT SCOPED''''
}

Table Asset {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  barcode String [unique, not null, note: 'Sensitive Financial Field']
  name String [not null]
  category String [not null]
  purchasePrice Decimal [not null]
  currentValue Decimal [not null]
  salvageValue Decimal [not null]
  usefulLifeYears Int [not null, note: 'Sensitive Financial Field']
  depreciationType String [not null]
  purchaseDate DateTime [not null]
  status String [not null]
  location String
  notes String
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  deletedBy String
  Note: '''Note: 'TENANT SCOPED''''
}

Table FixedAsset {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  assetNumber String [unique, not null]
  name String [not null]
  nameAr String [note: 'Sensitive Financial Field']
  description String
  categoryId Int
  parentAssetId Int [note: 'Sensitive Financial Field']
  isComposite Boolean [not null]
  isComponent Boolean [not null]
  componentType String
  acquisitionDate DateTime [not null]
  acquisitionCost Decimal [not null]
  currency String [not null]
  vendorId Int
  invoiceId Int
  acquisitionJournalId Int
  depreciationMethod String [not null]
  usefulLifeYears Int [note: 'Sensitive Financial Field']
  usefulLifeMonths Int
  declineRate Decimal
  totalEstimatedUnits Decimal
  unitsConsumed Decimal [not null]
  totalEstimatedHours Decimal
  hoursOperated Decimal [not null]
  salvageValue Decimal [not null]
  depreciationConvention String [not null]
  depreciationStartDate DateTime [not null, note: 'Sensitive Financial Field']
  accumulatedDepreciation Decimal [not null]
  accumulatedImpairment Decimal [not null]
  currentBookValue Decimal [not null]
  status String [not null]
  statusChangedAt DateTime
  disposalDate DateTime
  disposalProceeds Decimal
  disposalGainLoss Decimal
  disposalJournalId Int
  disposalType String
  heldForSaleDate DateTime
  heldForSaleJournalId Int
  locationId Int
  branchId Int
  costCenterId Int
  custodianEmployeeId Int
  insurancePolicyNumber String
  insuranceProvider String
  insurancePremium Decimal
  insuranceExpiryDate DateTime
  insuredValue Decimal
  serialNumber String
  barcode String [unique, note: 'Sensitive Financial Field']
  rfidTag String
  manufacturer String
  model String
  modelYear Int [note: 'Sensitive Financial Field']
  registrationNumber String
  warrantyStartDate DateTime [note: 'Sensitive Financial Field']
  warrantyEndDate DateTime [note: 'Sensitive Financial Field']
  warrantyVendorId Int [note: 'Sensitive Financial Field']
  cguId Int
  assetAccountId Int
  accumDepAccountId Int
  depExpenseAccountId Int [note: 'Sensitive Financial Field']
  nextMaintenanceDate DateTime
  maintenanceFrequencyMonths Int
  lastPhysicalCountDate DateTime
  lastPhysicalCountStatus String
  createdByUserId String [not null]
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
  Note: '''Note: 'TENANT SCOPED''''
}

Table FixedAssetCategory {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  code String [unique, not null]
  nameAr String [not null, note: 'Sensitive Financial Field']
  nameEn String [not null]
