  defaultDepreciationMethod String
  defaultUsefulLife Int
  defaultSalvageValuePercent Decimal
  assetAccountId Int
  accumDepAccountId Int
  depExpenseAccountId Int [note: 'Sensitive Financial Field']
  active Boolean [not null]
  Note: '''Note: 'TENANT SCOPED''''
}

