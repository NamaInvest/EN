Table Treasury {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  date DateTime [not null]
  type String [not null]
  amount Decimal [not null]
  description String
  referenceType String
  referenceId Int
  userId Int
  branchId Int
  deletedAt DateTime
  Note: '''Note: 'TENANT SCOPED''''
}

