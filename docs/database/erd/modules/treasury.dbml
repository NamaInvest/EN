Ref: BankTransaction.bankAccountId > BankAccount.id
Ref: BankStatement.bankAccountId > BankAccount.id
Ref: BankStatementLine.statementId > BankStatement.id
Ref: BankStatementLine.reconciliationId > BankReconPeriod.id
Ref: BankStatementReviewItem.lineId > BankStatementLine.id
Ref: BankReconRule.bankAccountId > BankAccount.id
Ref: BankReconPeriod.bankAccountId > BankAccount.id
Ref: BankReconciliationException.lineId > BankStatementLine.id
Ref: BankReconMatch.bankLineId > BankStatementLine.id
Ref: CashApplication.batchId > CashApplicationBatch.id
