  supplierInvoiceNo String
  purchaseOrderId Int
  ppvAmount Decimal [not null]
  paymentType String [not null]
  status String [not null]
  receiptStatus String [not null]
  userId Int
  notes String
  taxType String
  currencyId Int
  exchangeRate Decimal
  branchId Int
  deletedAt DateTime
  deletedBy String
  hasException Boolean [not null]
  Note: '''Note: 'TENANT SCOPED''''
}

