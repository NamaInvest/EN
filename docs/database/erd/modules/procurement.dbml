Table PurchaseOrder {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  orderNo Int [not null]
  date DateTime [not null]
  supplierId Int
  stockId Int [not null]
  subtotal Decimal [not null]
  taxValue Decimal [not null]
  total Decimal [not null]
  status String [not null]
  approvedBy Int [note: 'Sensitive Financial Field']
  userId Int
  branchId Int
  notes String
  isForeign Boolean [not null]
  letterOfCreditId Int
  salesOrderId Int
  deletedAt DateTime
  promisedDate DateTime
  Note: '''Note: 'TENANT SCOPED''''
}

Table PurchaseOrderDetail {
  id Int [primary key, not null]
  tenantId String [not null, note: 'Tenant Isolation']
  orderId Int [not null]
  productId Int [not null]
  productName String
  quantity Decimal [not null]
  price Decimal [not null]
  discountRate Decimal [not null]
  discountValue Decimal [not null]
  taxRate Decimal [not null]
  taxValue Decimal [not null]
  total Decimal [not null]
  deletedAt DateTime
  Note: '''Note: 'TENANT SCOPED''''
}

Table PurchaseInvoice {
  id Int [primary key, not null]
