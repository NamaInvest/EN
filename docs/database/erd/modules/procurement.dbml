Ref: PurchaseOrderDetail.orderId > PurchaseOrder.id
Ref: PurchaseInvoiceDetail.invoiceId > PurchaseInvoice.id
Ref: PurchaseReturnDetail.returnId > PurchaseReturn.id
Ref: PurchaseRequisitionDetail.reqId > PurchaseRequisition.id
Ref: VendorBidDetail.bidId > VendorBid.id
