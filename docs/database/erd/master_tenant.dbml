}

Table MfaUsedToken {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  user users [not null]
  tokenHash String [not null]
  usedAt DateTime [default: `now()`, not null]
  expiresAt DateTime [not null]

  indexes {
    (userId, tokenHash) [unique]
  }
}

Table user_permissions {
  id Int [pk, increment]
