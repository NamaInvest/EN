Ref: expenses.branchId > branches.id

Ref: treasury.userId > users.id

Ref: treasury.branchId > branches.id

Ref: audit_logs.userId > users.id

Ref: employees.branchId > branches.id

Ref: journal_entries.branchId > branches.id

Ref: branches.companyId > companies.id

Ref: shifts.userId > users.id

Ref: shifts.branchId > branches.id

Ref: bank_accounts.branchId > branches.id

Ref: cost_centers.branchId > branches.id

Ref: approval_rules.approverId > users.id

Ref: approval_requests.requestedBy > users.id

Ref: approval_steps.approverId > users.id

Ref: document_archives.createdBy > users.id

