Table companies {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  name String [not null]
  nameEn String
  taxNumber String
  commercialRecord String
  address String
  logoPath String
  ownershipPct Decimal [not null, default: 100]
  createdAt DateTime [default: `now()`, not null]
  branches branches [not null]
  subscriptions subscriptions [not null]
  deletedAt DateTime [note: '[SD]']
  deletedBy String
}

Table shifts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  stockId Int
  startTime DateTime [default: `now()`, not null]
  endTime DateTime
  status String [not null, default: 'open']
  startingCash Decimal [not null, default: 0]
  endingCashExpected Decimal
  endingCashActual Decimal
  difference Decimal
  notes String
  user users [not null]
  invoices sales_invoices [not null]
  salesReturns sales_returns [not null]
  branchId Int
  branch branches
}

Table bank_accounts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  branchId Int
  bankName String [not null]
  accountName String [not null]
  accountNumber String [not null]
  iban String
  currency String [not null, default: 'SAR']
  currentBalance Decimal [not null, default: 0]
  isActive Boolean [not null, default: true]
  bankCode String
  preferredFileFormat String
  fileEncoding String [not null, default: 'utf-8']
  fileColumnMapping Json
  openBankingProvider String
  openBankingAccountId String
  openBankingConsentExpiresAt DateTime
  openBankingLastFetchAt DateTime
  openBankingFetchEnabled Boolean [not null, default: false]
  openBankingFetchFrequency String [not null, default: 'DAILY']
  intraDayBalance Decimal
  intraDayBalanceUpdatedAt DateTime
  branch branches
  transactions bank_transactions [not null]
  lcs letters_of_credit [not null]
  lgs letters_of_guarantee [not null]
  statements bank_statements [not null]
  intraDayBalances IntraDayBalance [not null]
  BankReconRule bank_recon_rules [not null]
  BankReconPeriod BankReconPeriod [not null]
  deletedAt DateTime [note: '[SD]']
  deletedBy String
}

Table cost_centers {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  code String [unique, not null]
  name String [not null]
  nameEn String
  isActive Boolean [not null, default: true]
  branchId Int
  createdAt DateTime [default: `now()`, not null]
  branch branches
  journalLines journal_lines [not null]
  expenses expenses [not null]
  salesInvoices sales_invoices [not null]
  BudgetLine fng_budget_lines [not null]
  Encumbrance fng_encumbrances [not null]
  deletedAt DateTime [note: '[SD]']
  deletedBy String
}

Table approval_rules {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  documentType String [not null]
  minAmount Decimal [not null, default: 0]
  maxAmount Decimal
  approverRole String [not null]
  approverId Int
  level Int [not null, default: 1]
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  approver users
}

Table approval_requests {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  documentType String [not null]
  documentId Int [not null]
  status String [not null, default: 'pending']
  requestedBy Int [not null]
  requestedAt DateTime [default: `now()`, not null]
  steps approval_steps [not null]
  requester users [not null]
}

Table approval_steps {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  requestId Int [not null]
  approverId Int
  status String [not null, default: 'pending']
  notes String
  actionDate DateTime
  level Int [not null, default: 1]
  request approval_requests [not null]
  approver users
}

Table purchase_requisitions {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  reqNo Int [not null]
  date DateTime [default: `now()`, not null]
  department String
  status String [not null, default: 'pending']
  requestedBy Int
  approvedBy Int
  notes String
  requester users
  approver users
  details purchase_requisition_details [not null]
  deletedAt DateTime [note: '[SD]']
}

Table request_for_quotations {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  rfqNo Int [not null]
  date DateTime [default: `now()`, not null]
  dueDate DateTime
  supplierId Int
  status String [not null, default: 'draft']
  userId Int
  notes String
  supplier customers
  user users
  details request_for_quotation_details [not null]
}

Table goods_receipt_notes {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  grnNo Int [not null]
  date DateTime [default: `now()`, not null]
  supplierId Int
  orderId Int
  stockId Int [not null, default: 1]
  status String [not null, default: 'received']
  receivedBy Int
  notes String
  supplier customers
  order purchase_orders
  stock stocks
  receiver users
  details goods_receipt_note_details [not null]
  asnId String
  expectedArrivalDate DateTime
  rejectionQty Decimal
}

Table sys_alerts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  title String [not null]
  message String [not null]
  read Boolean [not null, default: false]
  alertType String [not null, default: 'INFO']
  linkUrl String
  createdAt DateTime [default: `now()`, not null]
  user users [not null]
}

Table tenant_accounts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  clerkUserId String [unique]
  userEmail String [unique, not null]
  orgName String [not null]
  vatNumber String [not null]
  subdomain String [unique, not null]
  status String [not null, default: 'pending']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  paymentStatus String [not null, default: 'pending']
  subscriptionDuration String [not null, default: '1_year']
  subscriptionStatus String [default: 'trial']
  plan String [default: 'free']
  trialEndsAt DateTime
  invoiceQuota Int [default: 30]
  productQuota Int [default: 1000]
  userQuota Int [default: 1]
  desktopLicenses desktop_licenses [not null]
  featureFlags tenant_feature_flags [not null]
}

Table desktop_licenses {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  licenseKey String [unique, not null]
  hardwareId String
  companyNameAr String
  companyNameEn String
  businessDomain String
  mobile String
  vatNumber String
  crnNumber String
  city String
  cityEn String
  district String
  streetName String
  buildingNo String
  postalCode String
  contactEmail String
  contactPhone String
  status String [default: 'trial']
  appVersion String
  maxDevices Int [default: 1]
  activatedDevices Int [default: 0]
  trialEndsAt DateTime
  expiresAt DateTime
  activatedAt DateTime
  lastVerifiedAt DateTime
  notes String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime [default: `now()`]
  tenantAccountId Int
  tenantAccount tenant_accounts
  featureFlags tenant_feature_flags [not null]
}

Table prescriptions {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  patientId Int [not null]
  wasfatyRef String
  doctorName String
  doctorLicense String
  clinicName String
  prescriptionDate String [not null]
  expiryDate String
  source String [not null, default: 'wasfaty']
  status String [not null, default: 'pending']
  imageUrl String
  pharmacistId Int
  dispensedAt DateTime
  notes String
  createdAt DateTime [default: `now()`, not null]
  patient pharmacy_patients [not null]
  pharmacist users
  items prescription_items [not null]
  claims insurance_claims [not null]
}

Table controlled_drug_logs {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  drugId Int [not null]
  patientNationalId String [not null]
  patientName String [not null]
  doctorName String [not null]
  doctorLicense String [not null]
  pharmacistId Int [not null]
  quantity Decimal [not null]
  batchNo String
  dispensedAt DateTime [default: `now()`, not null]
  notes String
  createdAt DateTime [default: `now()`, not null]
  drug pharmacy_drugs [not null]
  pharmacist users [not null]
}

Table pos_sessions {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  terminalId Int
  branchId Int
  openingFloat Decimal [not null, default: 0]
  closingFloat Decimal
  expectedClosing Decimal
  variance Decimal
  openedAt DateTime [default: `now()`, not null]
  closedAt DateTime
  status String [not null, default: 'OPEN']
  notes String
  user users [not null]
  movements pos_session_movements [not null]
}

Table ice_admins {
  id Int [pk, increment]
  username String [unique, not null]
  email String [unique, not null]
  passwordHash String [not null]
  fullName String [not null]
  roleId Int [not null]
  active Boolean [not null, default: true]
  twoFactorSecret String
  twoFactorEnabled Boolean [not null, default: false]
  lastLoginAt DateTime
  lastLoginIp String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime [note: '[SD]']
  role ice_admin_roles [not null]
  auditLogs ice_audit_logs [not null]
  supportTickets ice_support_tickets [not null]
  loginLogs ice_login_logs [not null]
  supportReplies ice_support_replies [not null]
}

Table ice_plans {
  id Int [pk, increment]
  name String [unique, not null]
  priceMonthly Decimal [not null, default: 0]
  priceYearly Decimal [not null, default: 0]
  maxUsers Int [not null, default: 1]
  maxBranches Int [not null, default: 1]
  maxInvoices Int [not null, default: 100]
  maxProducts Int [not null, default: 100]
  maxDesktopDevices Int [not null, default: 0]
  allowZatcaPhase2 Boolean [not null, default: false]
  allowDesktop Boolean [not null, default: false]
  dailyBackups Boolean [not null, default: false]
  active Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime [note: '[SD]']
  subscriptions ice_tenant_subscriptions [not null]
  planModules ice_plan_modules [not null]
}

Table ice_subscription_invoices {
  id Int [pk, increment]
  invoiceNo String [unique, not null]
  tenantId String [not null, note: '🔴 Tenant']
  subscriptionId Int [not null]
  amount Decimal [not null, default: 0]
  vatAmount Decimal [not null, default: 0]
  total Decimal [not null, default: 0]
  status String [not null, default: 'PENDING']
  paymentMethod String
  paymentGateRef String
  receiptNo String
  issueDate DateTime [default: `now()`, not null]
  dueDate DateTime [not null]
  paidAt DateTime
  subscription ice_tenant_subscriptions [not null]
}

Table ice_system_modules {
  id Int [pk, increment]
  code String [unique, not null]
  nameAr String [not null]
  nameEn String [not null]
  description String
  parentId Int
  isActive Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  parent ice_system_modules
  subModules ice_system_modules [not null]
  planModules ice_plan_modules [not null]
  tenantModules ice_tenant_modules [not null]
}

Table ice_desktop_licenses {
  id Int [pk, increment]
  licenseKey String [unique, not null]
  tenantId String [not null, note: '🔴 Tenant']
  subscriptionId Int [not null]
  hardwareId String [unique]
  deviceName String
  status String [not null, default: 'ACTIVE']
  appVersion String
  lastSyncAt DateTime
  offlineGraceDays Int [not null, default: 7]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  subscription ice_tenant_subscriptions [not null]
}

Ref: users.branchId > branches.id

Ref: users.mfaPolicyId > MfaPolicy.id

Ref: UserBackupCode.userId > users.id [delete: Cascade]

Ref: MfaAttempt.userId > users.id [delete: Cascade]

Ref: TrustedDevice.userId > users.id [delete: Cascade]

Ref: MfaRecoveryRequest.userId > users.id

Ref: MfaUsedToken.userId > users.id [delete: Cascade]

Ref: user_permissions.userId > users.id

Ref: stocks.branchId > branches.id

