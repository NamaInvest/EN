Table users {
  id Int [pk, increment]
  username String [unique, not null]
  passwordHash String [not null]
  fullName String [not null]
  role String [not null, default: 'cashier']
  phone String
  active Boolean [not null, default: true]
  sessionToken String
  deviceToken String
  deviceName String
  deviceBoundAt DateTime
  createdAt DateTime [default: `now()`, not null]
  permissions user_permissions [not null]
  salesInvoices sales_invoices [not null]
  purchaseInvoices purchase_invoices [not null]
  purchaseOrders purchase_orders [not null]
  approvals purchase_orders [not null]
  expenses expenses [not null]
  treasuryEntries treasury [not null]
  auditLogs audit_logs [not null]
  stockMovements stock_movements [not null]
  shifts shifts [not null]
  branchId Int
  branch branches
  approvalRules approval_rules [not null]
  approvalRequests approval_requests [not null]
  approvalSteps approval_steps [not null]
  archives document_archives [not null]
  prRequisitions purchase_requisitions [not null]
  prApprovals purchase_requisitions [not null]
  rfqs request_for_quotations [not null]
  goodsReceipts goods_receipt_notes [not null]
  alerts sys_alerts [not null]
  defaultPage String
  totpSecretEncrypted String
  totpIv String
  totpAuthTag String
  mfaEnabled Boolean [not null, default: false]
  mfaMethod String
  mfaPendingActivation Boolean [not null, default: false]
  mfaEnrolledAt DateTime
  mfaLastUsedAt DateTime
  mfaFailedAttempts Int [not null, default: 0]
  mfaLockedUntil DateTime
  mfaRequiredByPolicy Boolean [not null, default: false]
  mfaPolicyId Int
  mfaPolicy MfaPolicy
  mfaGracePeriodEndsAt DateTime
  mfaPhoneVerified String
  mfaPhoneVerifiedAt DateTime
  backupCodes UserBackupCode [not null]
  mfaAttempts MfaAttempt [not null]
  trustedDevices TrustedDevice [not null]
  recoveryRequests MfaRecoveryRequest [not null]
  usedTokens MfaUsedToken [not null]
  dispensedRx prescriptions [not null]
  controlledLogs controlled_drug_logs [not null, note: '🟡 Controlled']
  posSessions pos_sessions [not null]
  DocumentStateLog document_state_logs [not null]
  deletedAt DateTime [note: '[SD]']
}

Table UserBackupCode {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
