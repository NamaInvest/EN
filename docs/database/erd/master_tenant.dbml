  generatedBatchId String [not null]
}

Table MfaAttempt {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  user users [not null]
  success Boolean [not null]
  method String [not null]
  ipAddress String
  userAgent String
  countryCode String
  city String
  failureReason String
  attemptedAt DateTime [default: `now()`, not null]
  sessionId String
  deviceFingerprint String
}

Table MfaPolicy {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  name String [not null]
  description String
  enabled Boolean [not null, default: true]
  requireForRoles String[] [not null]
  requireForActions String[] [not null]
  allowedMethods String[] [not null]
  trustedDeviceDays Int [not null, default: 30]
  sessionTimeoutMinutes Int [not null, default: 480]
  enforceFromDate DateTime [not null]
  gracePeriodDays Int [not null, default: 7]
  stepUpRequired Boolean [not null, default: false]
  stepUpAfterMinutes Int [not null, default: 60]
  createdByUserId Int [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  users users [not null]
}

Table MfaRecoveryRequest {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  userId Int [not null]
  user users [not null]
  requestedAt DateTime [default: `now()`, not null]
