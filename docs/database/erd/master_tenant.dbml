Ref: ice_audit_logs.adminId > ice_admins.id

Enum FinancialPeriodStatus {
  OPEN
  SOFT_LOCKED
  HARD_LOCKED
}

Enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  POST
  REVERSE
  CANCEL
  VOID
  PRINT
  EXPORT
  LOGIN
  LOGOUT
}

Enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}