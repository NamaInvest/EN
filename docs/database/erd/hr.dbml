  type String [not null, default: 'CONSULT']
  status String [not null, default: 'SCHEDULED']
  date DateTime [not null]
  startTime String [not null]
  duration Int [not null, default: 15]
  notes String
  patient customers [not null]
  doctor employees [not null]
  room clinic_rooms
}

Table clinic_rx {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  patientId Int [not null]
  doctorId Int [not null]
  date DateTime [default: `now()`, not null]
  status String [not null, default: 'ACTIVE']
  notes String
  patient customers [not null]
  doctor employees [not null]
  items clinic_rx_items [not null]
}

Table clinic_lab_orders {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  patientId Int [not null]
  doctorId Int [not null]
  date DateTime [default: `now()`, not null]
  status String [not null, default: 'PENDING']
  notes String
  patient customers [not null]
  doctor employees [not null]
  results clinic_lab_results [not null]
}

Table qiwa_contracts {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  employeeId Int [not null]
  contractNo String [unique, not null]
  contractType String [not null]
  qiwaStatus String [not null]
  startDate DateTime [not null]
  endDate DateTime
  position String
  wageAmount Decimal
  wageCurrency String [not null, default: 'SAR']
  syncedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  employee employees [not null]
}

Table project_resources {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  projectId Int [not null]
  employeeId Int
  resourceName String
  role String [not null, default: 'MEMBER']
  allocation Decimal [not null, default: 100]
  hourlyRate Decimal [not null, default: 0]
  startDate DateTime
  endDate DateTime
  createdAt DateTime [default: `now()`, not null]
  project projects [not null]
  employee employees
}

Table project_time_entries {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  projectId Int [not null]
  taskId Int
  employeeId Int
  date DateTime [not null]
  hours Decimal [not null, default: 0]
  description String
  billable Boolean [not null, default: true]
  approved Boolean [not null, default: false]
  createdAt DateTime [default: `now()`, not null]
  project projects [not null]
  task project_tasks
  employee employees
}

