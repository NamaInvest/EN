Table employees {
  id Int [pk, increment]
  tenantId String [not null, default: 'default', note: '🔴 Tenant']
  employeeNo String [unique]
  name String [not null]
  phone String
  position String
  salary Decimal [not null, default: 0]
  housingAllowance Decimal [not null, default: 0]
  transportAllowance Decimal [not null, default: 0]
  otherAllowance Decimal [not null, default: 0]
  bankName String
  iban String
  startDate String
  active Boolean [not null, default: true]
  createdAt DateTime [default: `now()`, not null]
  branchId Int
  branch branches
  nationality String [not null, default: 'SAUDI']
  iqamaNumber String
  passportNumber String
  idNumber String
  birthDate DateTime
  gender String
  maritalStatus String
  faceDescriptor String
  department String
  managerId Int
  manager employees
  subordinates employees [not null]
  attendance attendance [not null]
  salaries salaries [not null]
  pettyCashes petty_cash_transactions [not null]
  salesTargets sales_targets [not null]
  salesOrders sales_orders [not null]
  salesInvoices sales_invoices [not null]
  routes routes [not null]
  evaluationsReceived hr_employee_evaluations [not null]
  evaluationsGiven hr_employee_evaluations [not null]
  trainings hr_training_enrollments [not null]
  fleetTrips fms_trips [not null]
  fuelLogs fms_fuel_logs [not null]
  classesTaught shl_academic_classes [not null]
  commissions com_salesman_commissions [not null]
  pettyCashFunds fng_petty_cash_funds [not null]
  Vacation vacations [not null]
  EmployeeLoan employee_loans [not null]
  PayrollInvoice payroll_invoices [not null]
  EndOfServiceCalculation end_of_service_calculations [not null]
  WPSBatchItem wps_batch_items [not null]
  LeaveBalance leave_balances [not null]
  LeaveAccrual leave_accruals [not null]
  LeaveRequest leave_requests [not null]
  DoctorSchedule clinic_schedules [not null]
  Appointment clinic_appointments [not null]
  ClinicPrescription clinic_rx [not null]
  LabOrder clinic_lab_orders [not null]
  qiwaWageProtectionId String
  mudadStatus String
  qiwaContracts qiwa_contracts [not null]
  projectResources project_resources [not null]
  projectTimeEntries project_time_entries [not null]
  deletedAt DateTime [note: '[SD]']
  deletedBy String
}

