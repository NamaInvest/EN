{
    "name": "namaweb",
    "version": "2.4.8",
    "private": true,
    "main": "electron/main.js",
    "scripts": {
        "dev": "next dev",
        "build": "npx prisma@5.22.0 generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
        "start": "next start",
        "worker": "tsx src/scripts/start_workers.ts",
        "start:whatsapp": "tsx src/workers/whatsapp.ts",
        "lint": "eslint src prisma tests __tests__ middleware.ts next.config.ts instrumentation.ts sentry.client.config.ts sentry.edge.config.ts sentry.server.config.ts",
        "db:generate": "npx prisma generate",
        "db:push": "npx prisma db push",
        "db:seed": "npx tsx prisma/seed.ts",
        "db:setup": "npx prisma db push && npx tsx prisma/seed.ts && npx tsx src/scripts/setup-db-triggers.ts",
        "db:studio": "npx prisma studio",
        "electron:dev": "concurrently \"node scripts/start-desktop.js\" \"wait-on http://localhost:3500 && electron .\"",
        "electron:build": "npm version patch --no-git-tag-version && node scripts/prebuild.js && cross-env ELECTRON_BUILD=1 next build && cross-env ELECTRON_BUILD=1 node scripts/clean-standalone.js && cross-env ELECTRON_BUILD=1 node scripts/protect-code.js && cross-env ELECTRON_BUILD=1 electron-builder --win",
        "electron:pack": "next build && electron-builder --dir",
        "electron:protect": "node scripts/protect-code.js",
        "prepare": "husky",
        "test": "jest --passWithNoTests --forceExit",
        "test:unit": "jest --selectProjects unit --passWithNoTests --forceExit",
        "test:e2e": "cross-env TEST_BASE_URL=http://localhost:3000 jest --testPathPattern=financial-integration --runInBand --forceExit",
        "test:cov": "jest --coverage --passWithNoTests --forceExit",
        "openapi": "node scripts/generate-openapi.js",
        "audit:zod": "node scripts/audit-zod.js",
        "audit:tenant": "node scripts/audit-tenant-isolation.js",
        "typecheck": "npx tsc --noEmit",
        "check:mojibake": "node scripts/check-mojibake.js",
        "validate": "npx tsc --noEmit && npx eslint src/ --max-warnings 0 && jest --passWithNoTests --forceExit",
        "db:migrate": "npx prisma migrate deploy",
        "clean": "rm -rf .next node_modules/.cache",
        "test:domain": "jest --testPathPattern=tests/ --passWithNoTests --forceExit",
        "health": "curl -s http://localhost:3000/api/health | npx -y prettier --parser json",
        "analyze": "cross-env ANALYZE=true npm run build",
        "erd:generate": "tsx scripts/generate-erd.ts",
        "test:integration": "vitest run tests/integration/accounting tests/integration/treasury tests/integration/sales tests/integration/procurement tests/integration/security",
        "test:security": "vitest run tests/security",
        "test:coverage": "vitest run --coverage",
        "test:e2e:list": "playwright test --list",
        "test:e2e:local": "playwright test"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.5.0",
