  "scripts": {
    "dev": "next dev",
    "build": "npx prisma@5.22.0 generate && next build --webpack",
    "start": "next start",
    "worker": "tsx src/scripts/start_workers.ts",
    "start:whatsapp": "tsx src/workers/whatsapp.ts",
    "lint": "eslint",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
