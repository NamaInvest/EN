# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backups and logs
*.tar.gz
*.zip
*.log
*.txt

# clerk configuration (can include secrets)
/.clerk/

# Build artifacts
/dist/
/extracted_asar/
/electron-protected/
/electron/zatca-sdk/
/.tmp-prisma-cli/

dist-electron/
.next-electron/
