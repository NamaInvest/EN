{
  "name": "namasoft-erp-launcher",
  "version": "2.4.10",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "dist": "electron-builder",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "set ESLINT_USE_FLAT_CONFIG=false&& node ./node_modules/eslint/bin/eslint.js \"electron/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "node-machine-id": "^1.1.12",
    "sql.js": "^1.10.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "@types/sql.js": "^1.4.9"
  }
}